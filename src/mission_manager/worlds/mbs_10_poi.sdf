            </box>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1.0</ambient>
            <diffuse>0.0 1.0 0.0 1.0</diffuse>
            <specular>0.0 0.2 0.0 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

